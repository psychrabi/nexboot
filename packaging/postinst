#!/bin/sh
# Runs after files are unpacked. It reloads systemd so the unit is known.
#
# Fresh install: stop there — DELIBERATELY. Enabling or starting now would boot
# a service with no env file (no pool, no bootstrap password), which
# crash-loops. The operator runs `ndiskless-configure` next; that writes the
# env and starts it.
#
# Upgrade of a running service: restart it so the new binary actually runs,
# except on the ACTIVE node of an HA cluster. Restarting the writer moves the
# VIP and drops clients; there the operator restarts deliberately (standbys
# first, then a planned switch or a restart of the active).
set -e

ENV_FILE=/etc/ndiskless/ndiskless.env

systemctl daemon-reload || true

# role 打印本节点 HA 角色（active/standby），读不到时为空。角色文件在库文件旁边。
role() {
  dsn=$(sed -n 's/^NDISKLESS_DB_DSN=//p' "$ENV_FILE" 2>/dev/null | tail -n 1 | tr -d '"')
  db=${dsn#file:}
  db=${db%%\?*}
  case "$db" in
    /*) sed -n 's/.*"role":"\([a-z]*\)".*/\1/p' "$(dirname "$db")/ha-role" 2>/dev/null ;;
  esac
}

if ! modinfo ntfs3 >/dev/null 2>&1; then
  echo "ndiskless: kernel module ntfs3 is missing; image preparation (driver and"
  echo "           script injection) needs it. Install it with:"
  echo "           sudo apt-get install linux-modules-extra-\$(uname -r)"
fi

if [ "$1" = "configure" ] && [ -n "$2" ] && systemctl is-active --quiet ndiskless 2>/dev/null; then
  peer=$(sed -n 's/^NDISKLESS_PEER_URL=//p' "$ENV_FILE" 2>/dev/null | tail -n 1 | tr -d '"')
  if [ -n "$peer" ] && [ "$(role)" != "standby" ]; then
    echo "ndiskless: upgraded. This is the active node of an HA cluster, so it was"
    echo "           NOT restarted. Upgrade the standbys first, then do a planned"
    echo "           switch (or: systemctl restart ndiskless) when ready."
  else
    echo "ndiskless: upgraded; restarting the service."
    systemctl restart ndiskless || echo "ndiskless: restart failed; check: journalctl -u ndiskless"
  fi
elif systemctl is-enabled --quiet ndiskless 2>/dev/null; then
  echo "ndiskless: upgraded. Start it when ready: systemctl start ndiskless"
else
  echo "ndiskless: installed. Configure and start it with:"
  echo "           sudo ndiskless-configure --bootstrap-password '<password>' \\"
  echo "                  --create-pool tank --pool-disks /dev/sdX"
  echo "           (add --peer/--vip/--cluster-token/--chap-secret for an HA pair)"
fi

exit 0
