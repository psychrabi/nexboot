[Unit]
Description=ndiskless - diskless boot control plane
# Import the pool and load LIO kernel modules before starting this service.
After=network-online.target zfs-import.target zfs.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/ndiskless/ndiskless.env
ExecStart=/opt/ndiskless/ndiskless
# Restart=always is part of HA role transitions: after writing a role marker, the process exits
# and systemd restarts it in the new role. Without automatic restart, failover stops at process exit.
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
