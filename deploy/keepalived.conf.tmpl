# keepalived configuration template for ndiskless high availability (issue 046).
# scripts/install-go.sh --peer/--vip fills the following placeholders before installation:
# /etc/keepalived/keepalived.conf：
#   @IFACE@        Client interface. VRRP heartbeats and VIP use the same NIC so loss of client
#                  connectivity also prevents serving clients, reducing split-brain scenarios.
#   @VIP@          Virtual IP used by clients for DHCP, TFTP, boot, and iSCSI.
#   @SELF_IP@      Physical IP of this node on the selected NIC.
#   @PEER_IP@      Peer node IPs, one per line. Use unicast because datacenter switches often filter multicast.
#                  Include all nodes: takeover depends on acquiring the VIP;
#                  client disk placement is an independent concern. Omitting a node from
#                  VRRP creates a standby that looks eligible in the UI but cannot take over.
#   @AUTH_PASS@    VRRP authentication password; maximum eight characters.
#   @PRIORITY@     Priority: active node 150, standby nodes start at 100 and increment by address order.
#                  A new, empty node must have lower priority than the node with data; otherwise
#                  it can overwrite the catalogue with an empty one. Standbys also need distinct
#                  priorities. Ties with three or more nodes can briefly create competing
#                  masters, each starting dnsmasq with the same epoch.
#
# Role-based priority (active 150 / standby 100+) with nopreempt ensures that the
# data-bearing node wins on simultaneous startup and the old master does not preempt after failover.
# Use the product's Planned Switchover action for intentional switchback.

global_defs {
    script_user root
    enable_script_security
}

vrrp_script ndiskless_health {
    script "/etc/keepalived/ndiskless-check.sh"
    interval 2
    timeout 5      # Must exceed the probe's worst-case time (2.5s) or it may falsely fail
    fall 2      # Release VIP only after two consecutive failures to tolerate probe jitter
    rise 2
}

vrrp_instance ndiskless {
    state BACKUP            # Both nodes start in BACKUP; the healthy node becomes master
    interface @IFACE@
    virtual_router_id 66
    priority @PRIORITY@     # Active: 150. Standby: 100+ by address, with no priority ties
    advert_int 1
    nopreempt

    unicast_src_ip @SELF_IP@
    unicast_peer {
        @PEER_IP@
    }

    authentication {
        auth_type PASS
        auth_pass @AUTH_PASS@
    }

    virtual_ipaddress {
        @VIP@
    }

    # On takeover, client and switch ARP caches still point at the former master's MAC.
    # Refresh ARP proactively rather than waiting for cache expiry.
    garp_master_delay 1
    garp_master_repeat 5
    garp_master_refresh 30

    track_script {
        ndiskless_health
    }

    notify_master "/etc/keepalived/ndiskless-notify.sh master"
    notify_backup "/etc/keepalived/ndiskless-notify.sh backup"
    notify_fault  "/etc/keepalived/ndiskless-notify.sh fault"
    notify_stop   "/etc/keepalived/ndiskless-notify.sh stop"
}
