# End-to-end environment template. Copy to env (ignored by .gitignore) and update for your test lab.
#
# Run test matrices on a cluster node with direct access to peers; external port forwarding is insufficient.
# Distribute these scripts alongside tools/e2e/*.py to all nodes with sync.sh.

# Three nodes' API addresses, comma-separated in installation order.
ND_NODES=http://192.168.10.3:8080,http://192.168.10.4:8080,http://192.168.10.5:8080
# Virtual IP held by the active writer.
ND_VIP=192.168.10.250

ND_PASSWORD='<admin-password>'          # Do not write real passwords into env.example; use the local env file.
ND_SSH_USER='<system-user>'           # Matrices use sudo -S for non-root SSH users.
ND_SSH_PASSWORD='<system-user-password>'
ND_CLUSTER_TOKEN='<cluster-token>'

ND_POOL=tank                      # Data pool
ND_BACKUP_POOL=tank2              # Backup pool, must differ from data pool (used by backup_matrix).
ND_IMPORT_DIR=/var/lib/ndiskless/imports

# An image source passing import health checks. Boot/backup matrices skip entire sections when absent.
# If no real Windows image is available, create a minimal fixture with fixtures/mkwin.sh.
ND_WINDOWS_SOURCE=/var/lib/ndiskless/imports/winmin.raw

# IP of the host running this script. failover_matrix performs destructive power/network fault injection,
# and must avoid disconnecting its own test runner host.
ND_RUNNER_IP=192.168.10.5

# For the topology.sh tiered suite only.
ND_HOSTS=192.168.10.3,192.168.10.4,192.168.10.5
ND_POOL_DISK=/dev/sdb             # Empty disk used to create a data pool.
ND_BINARY=/tmp/ndiskless-new      # Binary to install on the target node.
ND_SCRIPTS=/opt/ndiskless/scripts
ND_E2E_DIR=/home/${ND_SSH_USER}/e2e
